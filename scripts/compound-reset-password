#!/bin/sh
# Forgotten password: clears it so Compound returns to the setup screen. Your name,
# Trading 212 key and presets are kept. Run: docker compose exec app compound-reset-password
set -e
echo 'UPDATE "User" SET "passwordHash" = NULL;' | prisma db execute --stdin --schema /app/prisma/schema.prisma
echo "Password cleared. Open Compound in your browser to choose a new one."
