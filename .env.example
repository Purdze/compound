# Compound settings. Copy to .env next to docker-compose.yml, then run `docker compose up -d`.
# Your name, password and Trading 212 key are set up in the browser.

# ── Choose your database (uncomment one) ─────────────────────────────────────

# A. Your own Postgres (13+). Create a user and database for Compound first; see README.
# DATABASE_URL=postgresql://compound:password@your-postgres:5432/compound

# B. The Postgres included with Compound.
# COMPOSE_PROFILES=bundled-db
#    Its password defaults to "compound"; only the app container can reach it. To use
#    your own, set it before the first start: Postgres keeps its original password.
# POSTGRES_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────

# Port Compound is served on (default 3000).
# APP_PORT=3000

# The address you open Compound on. Only needed if it's served over https,
# e.g. behind a reverse proxy, so the sign-in cookie is marked Secure.
# APP_URL=https://compound.home.lan

# Trading 212 environment (default live). Use demo for a practice account.
# T212_BASE_URL=https://demo.trading212.com/api/v0

# Advanced: the encryption key and session secret are generated automatically on
# first start and kept in the compound-data volume. Set these only to supply your own
# (32 bytes, base64: openssl rand -base64 32).
# ENCRYPTION_KEY=
# SESSION_SECRET=

# Only for `bun dev` outside Docker, with option B above (see README). The Docker
# container keeps using the bundled database regardless.
# DATABASE_URL=postgresql://compound:compound@localhost:5432/compound?schema=public
# DATA_DIR=./.data
