generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Compound is single-user: one row with id "owner", created by the setup wizard
// (see src/lib/setup.ts). No passwordHash means setup hasn't been completed.
model User {
  id           String   @id
  name         String?
  passwordHash String?
  updateCheck  Boolean  @default(true)
  // Bumped by "Sign out everywhere"; part of every session signature.
  sessionEpoch Int      @default(0)
  createdAt    DateTime @default(now())

  apiKey    ApiKey?
  usageLogs ApiKeyUsageLog[]
  presets   CalculatorPreset[]
}

// One Trading 212 credential for the owner. `encryptedKey` holds AES-256-GCM ciphertext
// followed by the 16-byte auth tag; the plaintext is JSON {key, secret}.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String    @unique
  encryptedKey Bytes
  iv           Bytes
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKeyUsageLog {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  status    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CalculatorPreset {
  id         String   @id @default(cuid())
  userId     String
  name       String
  currentAge Int
  targetAge  Int
  goalAmount Int
  rate       Decimal  @db.Decimal(4, 1)
  lumpSum    Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
