generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Compound is single-user: one row with id "owner", created by the setup wizard
// (see src/lib/setup.ts). No passwordHash means setup hasn't been completed.
model User {
  id           String   @id
  name         String?
  passwordHash String?
  updateCheck  Boolean  @default(true)
  // Bumped by "Sign out everywhere"; part of every session signature.
  sessionEpoch Int      @default(0)
  createdAt    DateTime @default(now())

  apiKey           ApiKey?
  usageLogs        ApiKeyUsageLog[]
  presets          CalculatorPreset[]
  cashTransactions CashTransaction[]
  valueSnapshots   ValueSnapshot[]
}

// One Trading 212 credential for the owner. `encryptedKey` holds AES-256-GCM ciphertext
// followed by the 16-byte auth tag; the plaintext is JSON {key, secret}.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String    @unique
  encryptedKey Bytes
  iv           Bytes
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  // Set once a full walk of the transaction history has been stored.
  transactionsSyncedAt DateTime?
  // The T212ErrorCode (or MISSING_PERMISSION) from the last failed sync.
  transactionsError    String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]
  valueSnapshots   ValueSnapshot[]
}

// Deposits, withdrawals, transfers and fees, copied from Trading 212's transaction
// history. Belongs to the key it was fetched with, so replacing the key clears it.
model CashTransaction {
  id         String   @id @default(cuid())
  userId     String
  apiKeyId   String
  reference  String
  type       String
  amount     Decimal  @db.Decimal(18, 2)
  currency   String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, reference])
  @@index([userId, occurredAt])
}

model ApiKeyUsageLog {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  status    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CalculatorPreset {
  id         String   @id @default(cuid())
  userId     String
  name       String
  currentAge Int
  targetAge  Int
  goalAmount Int
  rate       Decimal  @db.Decimal(4, 1)
  lumpSum    Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// The portfolio's total value, one row per UTC day (the last value seen that day).
// Trading 212 has no value history, so this is the only record of it.
model ValueSnapshot {
  id         String   @id @default(cuid())
  userId     String
  apiKeyId   String
  day        DateTime @db.Date
  totalValue Decimal  @db.Decimal(18, 2)
  currency   String
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, day])
  @@index([userId, day])
}
